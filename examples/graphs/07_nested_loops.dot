// Nested loops with branches: stresses several back edges at once (inner-loop
// latch, outer-loop latch, and an early-continue), so each must wrap cleanly
// around its own source/target without colliding.
digraph nested_loops {
  entry      -> init
  init       -> outer_cond
  outer_cond -> outer_body
  outer_cond -> done
  outer_body -> inner_cond
  inner_cond -> inner_body
  inner_cond -> outer_upd
  inner_body -> guard
  guard      -> inner_upd
  guard      -> outer_upd      // early "continue" to the outer update
  inner_upd  -> inner_cond     // back edge: inner-loop latch
  outer_upd  -> outer_cond     // back edge: outer-loop latch
  done       -> exit

  entry      [label="entry"]
  init       [label="i = 0"]
  outer_cond [label="i < n ?"]
  outer_body [label="j = 0"]
  inner_cond [label="j < m ?"]
  inner_body [label="work(i, j)"]
  guard      [label="skip ?"]
  inner_upd  [label="j++"]
  outer_upd  [label="i++"]
  done       [label="cleanup"]
  exit       [label="return"]
}
