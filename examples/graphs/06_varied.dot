// Demonstrates layout with nodes of varied widths and heights. Widths and
// heights are explicit pixel values (not standard DOT inches) — the example
// viewer reads them directly.
digraph varied {
  start -> parse
  parse -> validate
  parse -> error
  validate -> transform
  validate -> error
  transform -> render
  error -> render
  render -> done

  start     [label="start"]
  parse     [label="parse input\nstream", height=56]
  validate  [label="validate schema and structure", width=240]
  transform [label="transform\nAST\ninto IR", height=72]
  error     [label="report error", width=120]
  render    [label="render output", width=140]
  done      [label="done"]
}
